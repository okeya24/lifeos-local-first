# 服务端口
PORT=8787

# 本地模型（默认，离线可用）
MODEL_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# 云端模型（可选，OpenAI 兼容格式）。不填 CLOUD_API_KEY 就全部走本地
CLOUD_API_BASE=https://open.bigmodel.cn/api/paas/v4
CLOUD_API_KEY=
CLOUD_MODEL=glm-4-flash

# 联网搜索（可选）：不填用匿名模式，有限速但免费
ANYSEARCH_API_KEY=

# 长期偏好自动提取：默认关闭，开启后需要 CLOUD_API_KEY
MEMORY_AUTO_EXTRACT=false

# 语音（可选）。没装 whisperkit 不影响文字对话
WHISPER_URL=http://127.0.0.1:50060
WHISPER_LANGUAGE=zh
VOICE_NAME=Tingting
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
