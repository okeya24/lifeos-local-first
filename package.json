{
  "name": "lifeos-local-first",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "本地优先的个人成长 AI 工作台：Markdown 笔记 + 神经网络可视化面板 + 本地大模型对话",
  "license": "MIT",
  "scripts": {
    "dev": "node --watch server/index.mjs",
